# Copy to `.env` on the VPS. Never commit real values.
# Keys already live in the local `.env` — do not paste them into chat.

CURSOR_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_FOUNDER_CHAT_ID=
OPENAI_API_KEY=
LINEAR_API_KEY=
LINEAR_TEAM_ID=
GMAIL_USER=
GMAIL_APP_PASS=
# Optional extra inboxes (read-only peek / search)
GMAIL_USER_AMZION=
GMAIL_APP_PASS_AMZION=
GMAIL_USER_ZION=
GMAIL_APP_PASS_ZION=
FOUNDER_EMAIL=aztodev@gmail.com

# Short PIN for mutating actions (Telegram). Never paste in chat.
FOUNDER_ACTION_PIN=

# Cloud HQ repo (private mirror of my_company — Noa, Ruth, Tamir on Cursor Cloud)
GITHUB_HQ_REPO=
GITHUB_HQ_REF=main

# Product repo (when product work starts)
GITHUB_REPO=
GITHUB_REF=main

# Optional — news / research. Put the key only in local/VPS .env, never in chat.
GEMINI_API_KEY=

# Meta Pixel — tracking only. Publishing needs a Page token (not the Pixel).
META_PIXEL_ID=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# YouTube — upload needs OAuth refresh token, not only an API key.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_REFRESH_TOKEN=

HQ_PORT=8788
HQ_BIND=127.0.0.1
# ChemiCloud desk: 1 = never run local Cursor on the VPS
HQ_CLOUD_ONLY=
EMET_CURSOR_MODEL=composer-2.5
